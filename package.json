{
  "name": "imp-editor-rifa",
  "productName": "Editor Rifa",
  "version": "1.0.0",
  "description": "Editor de artes para rifas e sorteios automotivos — Impera Services",
  "author": "Impera Services",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "homepage": "https://github.com/marcelolucas11/imp-editor-rifa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelolucas11/imp-editor-rifa.git"
  },
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.js",
    "css": "tailwindcss -c tailwind.config.js -i src/styles/input.css -o src/styles/app.css --minify",
    "icon": "python3 scripts/make_icon.py",
    "start": "npm run prepare-assets && npm run css && electron .",
    "build:mac": "npm run prepare-assets && npm run css && electron-builder --mac --universal --publish never",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/black-ops-one": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/faster-one": "^5.3.0",
    "@fontsource/fugaz-one": "^5.3.0",
    "@fontsource/kanit": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/racing-sans-one": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^3.4.17",
    "jszip": "^3.10.1"
  }
}
